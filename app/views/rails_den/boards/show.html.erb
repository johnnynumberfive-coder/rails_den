<div class="rails-den-community">
  <div class="rails-den-breadcrumbs">
    <%= link_to "Community", root_path %>

    <span class="rails-den-breadcrumb-separator">
      /
    </span>

    <span>
      <%= @board.category.title %>
    </span>

    <span class="rails-den-breadcrumb-separator">
      /
    </span>

    <span>
      <%= @board.title %>
    </span>
  </div>

  <header class="rails-den-board-page-header">
    <div>
      <p class="rails-den-board-page-category">
        <%= @board.category.title %>
      </p>

      <h1 class="rails-den-board-page-title">
        <%= @board.title %>
      </h1>

      <% if @board.description.present? %>
        <p class="rails-den-board-page-description">
          <%= @board.description %>
        </p>
      <% end %>
    </div>

    <p>
      <%= link_to "New Topic",
                  new_board_topic_path(@board),
                  class: "rails-den-navbar-button" %>
    </p>
  </header>

  <section class="rails-den-topics">
    <header class="rails-den-topics-header">
      <h2 class="rails-den-topics-title">
        Topics
      </h2>
    </header>

    <% if @topics.any? %>
      <div class="rails-den-board-list">
        <% @topics.each do |topic| %>
          <%= link_to topic_path(topic),
                      class: "rails-den-board" do %>
            <div class="rails-den-board-content">
              <h3 class="rails-den-board-title">
                <% if topic.pinned? %>
                  📌
                <% end %>

                <%= topic.title %>

                <% if topic.locked? %>
                  🔒
                <% end %>
              </h3>

              <p class="rails-den-board-description">
                Started
                <%= time_ago_in_words(topic.created_at) %>
                ago
              </p>
            </div>

            <div class="rails-den-board-arrow" aria-hidden="true">
              &rsaquo;
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="rails-den-topics-empty">
        <h3>No topics yet</h3>

        <p>
          Be the first to start a conversation in this board.
        </p>
      </div>
    <% end %>
  </section>
</div>
