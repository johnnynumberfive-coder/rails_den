<div class="rails-den-auth">
  <section class="rails-den-auth-card">
    <header class="rails-den-brand">
      <h1 class="rails-den-brand-name">RailsDen</h1>
      <p class="rails-den-brand-tagline">
        Forums. Chat. Community.
      </p>
    </header>

    <h2 class="rails-den-auth-title">Account settings</h2>

    <p class="rails-den-auth-description">
      Update your email address or change your password.
    </p>

    <% if flash[:notice] %>
      <div class="rails-den-notice">
        <%= flash[:notice] %>
      </div>
    <% end %>

    <% if @user.errors.any? %>
      <div class="rails-den-errors">
        <strong>We couldn't update your account.</strong>

        <ul>
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= simple_form_for @user,
                        url: main_app.registration_path,
                        method: :patch do |form| %>
      <div class="rails-den-field">
        <%= form.input :email_address,
                       label: "Email address",
                       required: true,
                       input_html: {
                         autocomplete: "email"
                       } %>
      </div>

      <div class="rails-den-field">
        <%= form.input :password,
                       label: "New password",
                       required: false,
                       hint: "Leave blank to keep your current password.",
                       input_html: {
                         autocomplete: "new-password",
                         maxlength: 72
                       } %>
      </div>

      <div class="rails-den-field">
        <%= form.input :password_confirmation,
                       label: "Confirm new password",
                       required: false,
                       input_html: {
                         autocomplete: "new-password",
                         maxlength: 72
                       } %>
      </div>

      <div class="rails-den-field">
        <%= form.input :current_password,
                       label: "Current password",
                       required: true,
                       input_html: {
                         autocomplete: "current-password",
                         maxlength: 72
                       } %>
      </div>

      <%= form.button :submit,
                      "Save changes",
                      class: "rails-den-button" %>
    <% end %>

    <div class="rails-den-auth-links">
      <%= link_to "Back to the community", "/rails_den/auth_probe" %>
    </div>
  </section>
</div>