<div class="rails-den-community">
  <header class="rails-den-community-header">
    <div>
      <h1 class="rails-den-community-title">RailsDen</h1>

      <p class="rails-den-community-tagline">
        Forums. Chat. Community.
      </p>
    </div>
  </header>

  <% if @categories.any? %>
    <div class="rails-den-category-list">
      <% @categories.each do |category| %>
        <section class="rails-den-category">
          <header class="rails-den-category-header">
            <div>
              <h2 class="rails-den-category-title">
                <%= category.title %>
              </h2>

              <% if category.description.present? %>
                <p class="rails-den-category-description">
                  <%= category.description %>
                </p>
              <% end %>
            </div>
          </header>

          <div class="rails-den-board-list">
            <% boards = category.boards
                                .where(enabled: true, visibility: "public")
                                .ordered %>

            <% if boards.any? %>
              <% boards.each do |board| %>
                <%= link_to board_path(board),
                            class: "rails-den-board" do %>
                  <div class="rails-den-board-icon" aria-hidden="true">
                    <% if board.icon.present? %>
                      <%= board.icon %>
                    <% end %>
                  </div>

                  <div class="rails-den-board-content">
                    <h3 class="rails-den-board-title">
                      <%= board.title %>
                    </h3>

                    <% if board.description.present? %>
                      <p class="rails-den-board-description">
                        <%= board.description %>
                      </p>
                    <% end %>
                  </div>

                  <div class="rails-den-board-arrow" aria-hidden="true">
                    &rsaquo;
                  </div>
                <% end %>
              <% end %>
            <% else %>
              <div class="rails-den-board-empty">
                No boards yet.
              </div>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>
  <% else %>
    <section class="rails-den-empty-state">
      <h2>No categories yet</h2>

      <p>
        This community is still getting set up.
      </p>
    </section>
  <% end %>
</div>
