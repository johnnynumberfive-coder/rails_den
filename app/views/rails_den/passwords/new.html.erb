<div class="rails-den-auth">
  <section class="rails-den-auth-card">
    <header class="rails-den-brand">
      <h1 class="rails-den-brand-name">RailsDen</h1>
      <p class="rails-den-brand-tagline">
        Forums. Chat. Community.
      </p>
    </header>

    <h2 class="rails-den-auth-title">Forgot your password?</h2>

    <p class="rails-den-auth-description">
      Enter your email address and we'll send you a password reset link.
    </p>

    <% if flash[:alert] %>
      <div class="rails-den-alert">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <% if flash[:notice] %>
      <div class="rails-den-notice">
        <%= flash[:notice] %>
      </div>
    <% end %>

    <%= simple_form_for :password_reset,
                        url: main_app.passwords_path do |form| %>
      <div class="rails-den-field">
        <%= form.input :email_address,
                       label: "Email address",
                       required: true,
                       autofocus: true,
                       input_html: {
                         autocomplete: "email"
                       } %>
      </div>

      <%= form.button :submit,
                      "Email reset instructions",
                      class: "rails-den-button" %>
    <% end %>

    <div class="rails-den-auth-links">
      <%= link_to "Back to sign in", main_app.new_session_path %>
    </div>
  </section>
</div>