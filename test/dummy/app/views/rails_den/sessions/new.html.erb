<div class="rails-den-auth">
  <section class="rails-den-auth-card">
    <header class="rails-den-brand">
      <h1 class="rails-den-brand-name">RailsDen</h1>
      <p class="rails-den-brand-tagline">
        Forums. Chat. Community.
      </p>
    </header>

    <h2 class="rails-den-auth-title">Welcome back</h2>

    <p class="rails-den-auth-description">
      Sign in to continue to your community.
    </p>

    <% if flash[:alert] %>
      <div class="rails-den-alert">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <% if flash[:notice] %>
      <div class="rails-den-notice">
        <%= flash[:notice] %>
      </div>
    <% end %>

    <%= simple_form_for :session, url: main_app.session_path do |form| %>
      <div class="rails-den-field">
        <%= form.input :email_address,
                       label: "Email address",
                       required: true,
                       autofocus: true,
                       input_html: {
                         autocomplete: "username",
                         value: params.dig(:session, :email_address)
                       } %>
      </div>

      <div class="rails-den-field">
        <%= form.input :password,
                       required: true,
                       input_html: {
                         autocomplete: "current-password",
                         maxlength: 72
                       } %>
      </div>

      <%= form.button :submit,
                      "Sign in",
                      class: "rails-den-button" %>
    <% end %>

    <div class="rails-den-auth-links">
      <%= link_to "Forgot your password?",
                  main_app.new_password_path %>

      <br>

      <%= link_to "Create an account",
                  main_app.new_registration_path %>
    </div>
  </section>
</div>